{
  "permissions": {
    "allow": [
      "Bash(./gradlew test)",
      "Bash(./gradlew build)",
      "Bash(./gradlew compileJava)",
      "Bash(./gradlew bootRun)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/secret-scan.sh" }
        ]
      }
    ]
  }
}
